{
  "compilerOptions": {
    "module": "node16",
    "target": "es2020",
    "moduleResolution": "node16",
    "types": ["node", "mocha"],
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,
    "strict": false,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true
  },
  "include": [
    "tests/**/*.ts",
    "src/**/*.ts"
  ]
}
