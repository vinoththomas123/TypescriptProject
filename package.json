  "main": "index.js",
  "scripts": {
    "axios": "ts-node TypescriptFW/lib/api/axios.ts",
    "run": "npx ts-node tests/tests.ts",
    "test": "mocha -r ts-node/register --timeout 30000 --reporter mochawesome --reporter-options \"reportDir=reports/test,html=true,json=true,overwrite=false\"",
    "test:all": "mocha -r ts-node/register --timeout 30000 --reporter mochawesome --reporter-options \"reportDir=reports/allTests,html=true,json=true,overwrite=false\" \"tests/**/*.ts\"",
    "VT": "mocha -r ts-node/register --timeout 10000000 --reporter mochawesome --reporter-options \"reportDir=reports/mochawesome-reports,reportFilename=VTReport,enableCode=false,html=true,json=true,overwrite=false\""
  },
